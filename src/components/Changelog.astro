---
import Base from '../layouts/Base.astro';
import { pathFor, type Lang } from '../data/i18n';
import { getChangelog } from '../data/changelog';
import { REPO, releaseDate } from '../data/release';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const entries = await getChangelog();
const latest = entries[0];
const T = zh
  ? {
      title: '更新日志 · 涛声 TaoSheng',
      desc: `涛声每个正式版改了什么${latest ? `。最新 v${latest.version}：${latest.headline}` : ''}`,
      eyebrow: '更新日志', h1: '每一版改了什么',
      lead: '涛声差不多每天发一版。App 会自动检查更新，在后台下好再提醒你装；App 里也能回看：设置 → 通用 → 版本更新。',
      rss: 'RSS 订阅', releases: 'GitHub Releases', versions: '版本', newest: '最新', more: (n: number) => `展开全部 ${n} 项改动`, less: '收起',
      empty: '暂时读不到更新日志，请到 GitHub 查看。',
    }
  : {
      title: 'Changelog — TaoSheng',
      desc: 'Every TaoSheng release, newest first.',
      eyebrow: 'Changelog', h1: 'What changed, release by release',
      lead: 'TaoSheng ships almost daily, and the app updates itself in the background. Release notes are written in Chinese; each entry below links to the full notes.',
      rss: 'RSS (Chinese)', releases: 'GitHub Releases', versions: 'Versions', newest: 'Latest', more: () => 'Full notes (Chinese) →', less: '',
      empty: 'The changelog is unavailable right now. See GitHub instead.',
    };
const count = (e: (typeof entries)[number]) => e.groups.reduce((n, g) => n + g.items.length, 0);
const date = (d: string) => (zh ? d : releaseDate(`${d}T12:00:00+08:00`, 'en'));
---
<Base lang={lang} path="/changelog" title={T.title} description={T.desc}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="涛声更新日志" href="/changelog.xml" />

  <section class="pt-32 pb-10 sm:pt-40">
    <div class="wrap">
      <p class="eyebrow reveal">{T.eyebrow}</p>
      <h1 class="reveal mt-5 text-[clamp(2.4rem,6vw,4.6rem)] font-bold leading-[1.05] tracking-[-0.035em]" style="--d:60ms">{T.h1}</h1>
      <p class="lead reveal mt-6 max-w-2xl" style="--d:120ms">{T.lead}</p>
      <p class="reveal mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[14px]" style="--d:160ms">
        <a class="cl-link" href="/changelog.xml">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="19" r="2.5"/><path d="M3 10.5a10.5 10.5 0 0 1 10.5 10.5h-3A7.5 7.5 0 0 0 3 13.5zM3 3.5A17.5 17.5 0 0 1 20.5 21h-3A14.5 14.5 0 0 0 3 6.5z"/></svg>
          {T.rss}
        </a>
        <a class="cl-link" href={`${REPO}/releases`} target="_blank" rel="noopener">{T.releases} ↗</a>
      </p>
    </div>
  </section>

  <section class="pb-28">
    <div class="wrap grid gap-12 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-16">
      <aside class="hidden lg:block">
        <nav class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2" aria-label={T.versions}>
          <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-3)]">{T.versions}</p>
          <ol class="space-y-0.5">
            {entries.map((e) => (
              <li><a href={`#v${e.version}`} data-toc={e.version} class="toc-link"><span class="tnum font-semibold">{e.version}</span><span class="tnum text-[12.5px] text-[var(--color-ink-3)]">{e.date.slice(5)}</span></a></li>
            ))}
          </ol>
        </nav>
      </aside>

      <div class="min-w-0 max-w-3xl">
        {entries.length === 0 && (
          <p class="rounded-[20px] bg-white p-6 text-[15px]">{T.empty} <a class="cl-link" href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">CHANGELOG.md ↗</a></p>
        )}
        {entries.map((e, i) => (
          <article id={`v${e.version}`} class="entry" data-entry={e.version}>
            <header>
              <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <a href={`#v${e.version}`} class="serif tnum text-[40px] leading-none text-[var(--color-ink)] hover:text-[var(--color-accent-deep)]">v{e.version}</a>
                <time datetime={e.date} class="tnum text-[14px] text-[var(--color-ink-3)]">{date(e.date)}</time>
                {i === 0 && <span class="badge">{T.newest}</span>}
              </p>
              <h2 class="mt-3 text-[1.3rem] font-semibold leading-snug tracking-tight text-pretty" lang="zh-CN">{e.headline}</h2>
            </header>

            {zh ? (
              <details class="mt-5" open={i === 0}>
                <summary class="cl-summary"><span class="when-closed">{T.more(count(e))}</span><span class="when-open">{T.less}</span></summary>
                <div class="prose-ts cl-body mt-5">
                  {e.groups.map((g) => (
                    <>
                      {g.title && <h3>{g.title}</h3>}
                      <ul>{g.items.map((it) => <li set:html={it} />)}</ul>
                    </>
                  ))}
                  {e.notes.length > 0 && <div class="cl-notes">{e.notes.map((n) => <p set:html={n} />)}</div>}
                </div>
              </details>
            ) : (
              <a href={`${pathFor('zh', '/changelog')}#v${e.version}`} hreflang="zh-CN" class="cl-link mt-4 inline-block text-[14px]">{T.more(0)}</a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .cl-link { display: inline-flex; align-items: center; gap: 6px; color: var(--color-accent-deep); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent); text-underline-offset: 4px; }
  .toc-link { display: flex; justify-content: space-between; align-items: baseline; padding: 7px 12px; border-radius: 10px; font-size: 14.5px; color: var(--color-ink-2); transition: background-color .2s, color .2s; }
  .toc-link:hover { background: rgba(29, 27, 25, 0.05); color: var(--color-ink); }
  .toc-link.on { background: #fff; color: var(--color-ink); box-shadow: 0 10px 30px -20px rgba(29, 27, 25, .5); }
  .entry { padding: 44px 0; border-top: 1px solid var(--color-line); scroll-margin-top: 96px; }
  .entry:first-child { border-top: 0; padding-top: 8px; }
  .badge { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent-deep); }
  .cl-summary { display: inline-flex; cursor: pointer; list-style: none; font-size: 14px; font-weight: 600; color: var(--color-ink-2); padding: 8px 14px; border-radius: 999px; background: #fff; }
  .cl-summary::-webkit-details-marker { display: none; }
  .cl-summary:hover { color: var(--color-ink); }
  details:not([open]) .when-open, details[open] .when-closed { display: none; }
  .cl-body :global(h3:first-child) { margin-top: 0; }
  .cl-notes { margin-top: 24px; padding: 14px 18px; border-radius: 16px; background: var(--color-paper-2); font-size: 14px; color: var(--color-ink-2); }
  .cl-notes :global(p) { margin: 0; }
  .cl-notes :global(p + p) { margin-top: 6px; }
</style>

<script>
  // 带 #v0.5.7 打开的链接：展开对应版本并滚过去
  const openHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    const d = el?.querySelector('details');
    if (d && !d.open) { d.open = true; el!.scrollIntoView(); }
  };
  openHash();
  addEventListener('hashchange', openHash);

  const links = document.querySelectorAll<HTMLElement>('[data-toc]');
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const v = (e.target as HTMLElement).dataset.entry;
      links.forEach((l) => l.classList.toggle('on', l.dataset.toc === v));
    }),
    { rootMargin: '-20% 0px -70% 0px' },
  );
  document.querySelectorAll('[data-entry]').forEach((c) => io.observe(c));
</script>
