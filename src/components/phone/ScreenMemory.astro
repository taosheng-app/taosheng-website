---
import Chrome from './Chrome.astro';
interface Props { lang: 'zh' | 'en'; class?: string; on?: boolean }
const { lang, class: cls, on } = Astro.props;
const zh = lang === 'zh';
const c = zh
  ? {
      title: '记忆', exp: '导出', byDay: '按天', byType: '按类', month: '2026年11月', back: '回到今天',
      wk: ['一', '二', '三', '四', '五', '六', '日'], days: [16, 17, 18, 19, 20, 21, 22],
      rv: '当天回顾', rvAt: '昨天 22:00 生成',
      rvText: '上午评审了新版首页方案，下午和客户通了电话、定好报价思路，晚上陪孩子拼完了乐高城堡。',
      env: '环境：键盘声、雨',
      full: '查看完整回顾 ›', regen: '重新生成',
      cards: '卡片', cn: '2 张', gen: '+ 生成',
      k: [
        ['会议速记', '11:05–11:42', '新版首页方案评审', '三人讨论首屏文案和下载按钮位置；定下周五前出第二版，小周负责截图。'],
        ['通话·访谈', '15:10–15:31', '和客户确认报价思路', '客户希望分两期付款；你答应周一前发正式报价，并附上案例。'],
      ],
      tl: '时间线', tln: '24 件事', newest: '↑ 新的在上',
    }
  : {
      title: 'Memory', exp: 'Export', byDay: 'Day', byType: 'Type', month: 'November 2026', back: 'Today',
      wk: ['M', 'T', 'W', 'T', 'F', 'S', 'S'], days: [16, 17, 18, 19, 20, 21, 22],
      rv: 'Daily review', rvAt: 'yesterday 22:00',
      rvText: 'Reviewed the new homepage in the morning, agreed on pricing with a client by phone in the afternoon, finished a LEGO castle with the kids at night.',
      env: 'Around you: keyboard, rain',
      full: 'Full review ›', regen: 'Regenerate',
      cards: 'Cards', cn: '2', gen: '+ New',
      k: [
        ['Meeting notes', '11:05–11:42', 'Homepage design review', 'Hero copy and the download button. Second draft due Friday; Zhou owns the screenshots.'],
        ['Call', '15:10–15:31', 'Pricing call with a client', 'They want to pay in two parts. You promised a formal quote with case studies by Monday.'],
      ],
      tl: 'Timeline', tln: '24 events', newest: '↑ Newest',
    };
---
<div class:list={['app', cls, on && 'on']} data-screen="memory">
  <Chrome lang={lang} part="top" />
  <div class="a-head" style="display:flex;justify-content:space-between;align-items:center;padding-right:14px">
    <div class="rail"></div>
    <div class="big">{c.title}</div>
    <div style="display:flex;gap:8px;align-items:center;font-size:13.5px">
      <span class="a-pill" style="background:var(--soft);color:var(--accent);font-weight:500">{c.exp}</span>
      <span style="display:flex;background:var(--card);border-radius:999px;padding:3px"><span class="a-pill" style="background:var(--soft);color:var(--accent);height:26px;font-weight:600">{c.byDay}</span><span class="a-pill" style="height:26px;color:var(--t2);font-weight:500">{c.byType}</span></span>
    </div>
  </div>

  <div class="a-card" style="margin:14px 14px 0;padding:14px 14px 12px;border-radius:22px">
    <div style="display:flex;justify-content:space-between;align-items:center"><b style="font-size:16px;font-weight:650">{c.month} <span style="color:var(--t3);font-weight:400;font-size:12px">⌄</span></b><span style="color:var(--accent);font-size:13px">{c.back}  <span style="color:var(--t2)">‹  ›</span></span></div>
    <div style="display:grid;grid-template-columns:repeat(7,1fr);text-align:center;margin-top:12px;font-size:12px;color:var(--t3)">{c.wk.map((w) => <span>{w}</span>)}</div>
    <div style="display:grid;grid-template-columns:repeat(7,1fr);text-align:center;margin-top:8px;font-size:16px" class="tnum">
      {c.days.map((d) => (
        <span style="display:grid;place-items:center">
          <span style={`width:34px;height:34px;border-radius:50%;display:grid;place-items:center;${d === 19 ? 'background:var(--accent);color:#fff;font-weight:600' : d === 20 ? 'color:var(--accent);font-weight:600' : d > 20 ? 'color:var(--sep)' : ''}`}>{d}</span>
          <i style={`width:4px;height:4px;border-radius:50%;margin-top:3px;background:${d <= 20 ? 'var(--accent)' : 'transparent'};opacity:${d === 19 ? 0 : 0.6}`}></i>
        </span>
      ))}
    </div>
  </div>

  <div style="margin:12px 14px 0;padding:14px 16px;border-radius:22px;background:var(--soft2)">
    <div style="font-size:12.5px"><span style="color:var(--accent)">{c.rv}</span><span style="color:var(--t3)"> · {c.rvAt}</span></div>
    <div style="font-size:15px;line-height:1.6;margin-top:6px;font-weight:500">{c.rvText}</div>
    <div style="font-size:13px;color:var(--t2);margin-top:4px">{c.env}</div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;font-size:13px"><span style="color:var(--accent)">{c.full}</span><span class="a-pill" style="background:var(--card);color:var(--accent);height:28px;font-weight:500">{c.regen}</span></div>
  </div>

  <div class="a-section" style="margin-top:16px;align-items:center"><span><b>{c.cards}</b>  {c.cn}</span><span class="a-pill" style="background:var(--soft);color:var(--accent);height:28px;font-weight:500">{c.gen}</span></div>
  <div class="a-card" style="margin:10px 14px 0;border-radius:22px;padding:2px 0">
    {c.k.map(([kind, time, title, d], i) => (
      <div style="display:grid;grid-template-columns:42px 1fr;gap:12px;padding:12px 16px">
        <span style="width:38px;height:38px;border-radius:12px;background:#e6edf7;color:#5a78a8;display:grid;place-items:center"><svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="7.5" cy="7" r="2.6" stroke="currentColor" stroke-width="1.6"/><circle cx="13.5" cy="7.6" r="2.1" stroke="currentColor" stroke-width="1.6"/><path d="M2.8 16c.5-2.6 2.4-4 4.7-4s4.2 1.4 4.7 4M12.6 12.2c2.2-.3 4 .9 4.6 3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
        <div style={`min-width:0;${i ? 'border-top:1px solid var(--sep);padding-top:12px;margin-top:-12px' : ''}`}>
          <div style="font-size:12px"><span style="color:#5a78a8">{kind}</span><span style="color:var(--t3)"> · {time}</span></div>
          <div style="font-size:15px;font-weight:650;margin-top:2px">{title}</div>
          <div style="font-size:12.5px;color:var(--t2);line-height:1.55;margin-top:3px">{d}</div>
        </div>
      </div>
    ))}
  </div>
  <div class="a-section" style="margin-top:16px;align-items:center"><span><b>{c.tl}</b>  {c.tln}</span><span class="a-pill" style="background:var(--card);color:var(--text);height:28px;font-weight:500">{c.newest}</span></div>
  <Chrome lang={lang} part="bottom" tab={2} />
</div>
