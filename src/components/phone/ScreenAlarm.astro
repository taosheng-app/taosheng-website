---
/** 强提醒整屏页。照 App 的 StrongAlarmActivity：橙色渐变、大时间、呼吸光圈里摇摆的铃铛、两个大按钮。 */
import Chrome from './Chrome.astro';
interface Props { lang: 'zh' | 'en'; class?: string }
const { lang, class: cls } = Astro.props;
const zh = lang === 'zh';
const c = zh
  ? { due: '到点了', text: '给星河科技发报价单', snooze: '5 分钟后', done: '已完成', stop: '不再响', keys: '音量键 = 5 分钟后 · 电源键 = 不再响' }
  : { due: 'It’s time', text: 'Send Starriver Tech the quote', snooze: 'In 5 min', done: 'Done', stop: 'Stop ringing', keys: 'Volume = 5 min later · Power = stop' };
---
<div class:list={['app alarm', cls]} data-screen="alarm">
  <div style="color:#fff"><Chrome lang={lang} part="top" time="14:00" /></div>
  <div style="display:flex;flex-direction:column;align-items:center;padding:0 24px;height:calc(100% - 36px)">
    <div class="tnum" style="margin-top:62px;font-size:72px;line-height:80px;font-weight:300;color:#fff">14:00</div>
    <div style="font-size:14px;color:rgba(255,255,255,.85)">{c.due}</div>
    <div style="position:relative;width:150px;height:150px;margin-top:40px;display:grid;place-items:center">
      <i class="alarm-halo"></i>
      <i style="position:absolute;width:108px;height:108px;border-radius:50%;background:rgba(255,255,255,.22)"></i>
      <svg class="alarm-bell" width="56" height="56" viewBox="0 0 56 56" aria-hidden="true"><path d="M28 7a3 3 0 013 3v1.6c7.4 1.4 12 7.6 12 15.4v9l4 5v2H9v-2l4-5v-9c0-7.8 4.6-14 12-15.4V10a3 3 0 013-3z" fill="#fff"/><path d="M22 46a6 6 0 0012 0" fill="#fff"/></svg>
    </div>
    <div style="margin-top:36px;font-size:24px;line-height:32px;font-weight:600;color:#fff;text-align:center">{c.text}</div>
    <div style="flex:1"></div>
    <div style="display:flex;gap:12px;width:100%">
      <span style="flex:1;height:60px;border-radius:30px;background:rgba(255,255,255,.2);color:#fff;display:grid;place-items:center;font-size:18px;font-weight:600">{c.snooze}</span>
      <span style="flex:1;height:60px;border-radius:30px;background:#fff;color:#E8582A;display:grid;place-items:center;font-size:18px;font-weight:600">{c.done}</span>
    </div>
    <div style="margin-top:14px;padding:10px 24px;font-size:15px;font-weight:500;color:rgba(255,255,255,.9)">{c.stop}</div>
    <div style="margin:8px 0 34px;font-size:12px;color:rgba(255,255,255,.65)">{c.keys}</div>
  </div>
</div>
