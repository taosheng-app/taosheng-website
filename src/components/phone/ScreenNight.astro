---
import Chrome from './Chrome.astro';
interface Props { lang: 'zh' | 'en'; class?: string; on?: boolean; dark?: boolean }
const { lang, class: cls, on, dark = true } = Astro.props;
const zh = lang === 'zh';
const c = zh
  ? {
      title: '昨晚', sub: '11月20日早上醒来', trend: '趋势',
      grid: [['上床', '23:18'], ['约入睡', '23:41'], ['起床', '07:05'], ['睡了', '7小时24分']],
      conf: '可信度：好', mapT: '夜里的声音和动静', hint: '点圆点回听 · 双指或双击放大 · 长按看几点几分多响',
      legend: [['鼾声', 'var(--snore)'], ['梦话', 'var(--good)'], ['咳嗽', 'var(--warn)'], ['醒了', 'var(--t2)']],
      rows: [
        ['鼾声', '3 段 · 共 22 分', 'var(--snore)'],
        ['你的梦话', '03:12 “把那个箱子搬到阳台……”', 'var(--good)'],
        ['疑似咳嗽/清嗓', '2 次', 'var(--warn)'],
        ['醒了', '04:52 · 1 次', 'var(--t2)'],
      ],
      tryT: '试试看', tryS: '标上昨晚的情况，几晚后就能对比', tags: ['侧睡', '开了加湿器', '喝了酒', '+ 自定义'],
      note: '由手机录音自动统计，仅供参考，不是医疗检查。',
      hours: ['0点', '2点', '4点', '6点'],
    }
  : {
      title: 'Last night', sub: 'Woke up Nov 20', trend: 'Trends',
      grid: [['In bed', '23:18'], ['Asleep', '23:41'], ['Up', '07:05'], ['Slept', '7h 24m']],
      conf: 'Confidence: good', mapT: 'Sounds through the night', hint: 'Tap a dot to listen · pinch to zoom · long-press for time and loudness',
      legend: [['Snore', 'var(--snore)'], ['Talk', 'var(--good)'], ['Cough', 'var(--warn)'], ['Awake', 'var(--t2)']],
      rows: [
        ['Snoring', '3 stretches · 22 min', 'var(--snore)'],
        ['You talked in your sleep', '03:12 “move that box to the balcony…”', 'var(--good)'],
        ['Cough / throat clearing', '2 times', 'var(--warn)'],
        ['Awake', '04:52 · once', 'var(--t2)'],
      ],
      tryT: 'Try it', tryS: 'Tag the night, compare after a few', tags: ['Side sleeping', 'Humidifier on', 'Had a drink', '+ Custom'],
      note: 'Estimated from phone audio. For reference only, not a medical test.',
      hours: ['0:00', '2:00', '4:00', '6:00'],
    };
// 声音地图：23:00 → 07:30，宽 300
const W = 300, H = 92, t0 = 23 * 60, span = 8.5 * 60;
const x = (h: number, m: number) => (((h < 12 ? h + 24 : h) * 60 + m - t0) / span) * W;
const bars = Array.from({ length: 100 }, (_, i) => {
  const n = Math.sin(i * 1.7) * 0.5 + Math.sin(i * 0.37) * 0.5;
  return 4 + Math.abs(n) * 9 + (i % 9 === 0 ? 6 : 0);
});
const snore = [[1, 8], [1, 14], [1, 19], [1, 25], [1, 31], [1, 37], [4, 18], [4, 24], [4, 29], [5, 55], [6, 2]];
const dots = [
  ...snore.map(([h, m], i) => ({ cx: x(h, m), cy: 26 + (i % 3) * 7, r: 3.6, f: 'var(--snore)' })),
  { cx: x(3, 12), cy: 20, r: 5, f: 'var(--good)' },
  { cx: x(2, 6), cy: 34, r: 4, f: 'var(--warn)' },
  { cx: x(5, 41), cy: 30, r: 4, f: 'var(--warn)' },
  { cx: x(4, 52), cy: 18, r: 4, f: 'var(--t2)' },
];
---
<div class:list={['app', dark && 'dark', cls, on && 'on']} data-screen="night">
  <Chrome lang={lang} part="top" time="7:12" />
  <div style="display:flex;justify-content:center;margin-top:4px"><span style="width:36px;height:4.5px;border-radius:3px;background:var(--t3);opacity:.5"></span></div>
  <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:12px 18px 0">
    <div><div style="font-size:24px;font-weight:700">{c.title}</div><div style="font-size:13px;color:var(--t2);margin-top:2px">{c.sub}</div></div>
    <span style="color:var(--accent);font-size:14px;padding:8px 0">{c.trend}</span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 14px 0">
    {c.grid.map(([l, v], i) => (
      <div style="background:var(--card);border-radius:16px;padding:10px 0 9px;text-align:center">
        <div class="tnum" style={`font-size:${i === 3 ? 13.5 : 18}px;letter-spacing:${i === 3 ? '-.02em' : '0'};font-weight:650;line-height:24px`}>{v}</div>
        <div style="font-size:11.5px;color:var(--t2);margin-top:1px">{l}</div>
      </div>
    ))}
  </div>
  <div style="display:flex;align-items:center;gap:6px;margin:10px 18px 0;font-size:12px;color:var(--t2)"><i style="width:7px;height:7px;border-radius:50%;background:var(--good)"></i>{c.conf}</div>

  <div class="a-card" style="margin:12px 14px 0;padding:14px 12px 12px;border-radius:20px">
    <div style="font-size:14px;font-weight:600;padding:0 4px">{c.mapT}</div>
    <svg viewBox={`0 0 ${W} ${H + 18}`} width="100%" style="display:block;margin-top:10px" aria-hidden="true">
      <rect x={x(23, 41)} y="2" width={x(7, 5) - x(23, 41)} height={H - 4} rx="8" fill="rgba(126,79,198,.10)" />
      {bars.map((b, i) => <rect x={i * 3} y={H - 10 - b} width="1.6" height={b} rx=".8" fill="var(--t3)" opacity=".55" />)}
      {dots.map((d) => <circle cx={d.cx} cy={d.cy} r={d.r} fill={d.f} />)}
      <line x1={x(4, 52)} x2={x(4, 52)} y1="24" y2={H - 10} stroke="var(--t2)" stroke-dasharray="2 3" stroke-width="1" />
      {c.hours.map((h, i) => <text x={x(i * 2, 0)} y={H + 14} font-size="10" fill="var(--t3)" text-anchor="middle">{h}</text>)}
    </svg>
    <div style="display:flex;gap:12px;font-size:11.5px;color:var(--t2);margin:6px 4px 0">
      {c.legend.map(([n, col]) => <span style="display:flex;align-items:center;gap:4px"><i style={`width:7px;height:7px;border-radius:50%;background:${col}`}></i>{n}</span>)}
    </div>
    <div style="font-size:11px;color:var(--t3);margin:8px 4px 0">{c.hint}</div>
  </div>

  <div class="a-card" style="margin:10px 14px 0;border-radius:20px">
    {c.rows.map(([n, d, col], i) => (
      <div style={`display:flex;align-items:center;gap:10px;padding:11px 14px;${i ? 'border-top:1px solid var(--sep)' : ''}`}>
        <i style={`width:8px;height:8px;border-radius:50%;background:${col};flex:none`}></i>
        <div style="min-width:0;flex:1"><div style="font-size:14px;font-weight:600">{n}</div><div style="font-size:12px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{d}</div></div>
        {i < 3 && <span style="width:28px;height:28px;border-radius:50%;background:var(--soft);color:var(--accent);display:grid;place-items:center;flex:none"><svg width="10" height="11" viewBox="0 0 10 11" aria-hidden="true"><path d="M1.5 1.2v8.6L9 5.5z" fill="currentColor"/></svg></span>}
      </div>
    ))}
  </div>

  <div style="margin:14px 18px 0"><span style="font-size:14px;font-weight:600">{c.tryT}</span><span style="font-size:12px;color:var(--t3);margin-left:8px">{c.tryS}</span></div>
  <div style="display:flex;flex-wrap:wrap;gap:7px;margin:9px 14px 0">
    {c.tags.map((t, i) => <span class="a-chip" style={i === 0 ? 'background:var(--soft);color:var(--accent)' : ''}>{t}</span>)}
  </div>
  <div style="font-size:11px;color:var(--t3);margin:14px 18px 0">{c.note}</div>
  <Chrome lang={lang} part="bottom" tabs={false} />
</div>
