---
interface Props {
  yes: boolean;
}
const { yes } = Astro.props;
---

{yes ? (
  <svg class="h-5 w-5 text-green-500 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M4.5 12.75l6 6 9-13.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
) : (
  <span class="text-sm text-primary-950/40" aria-label="No">—</span>
)}
