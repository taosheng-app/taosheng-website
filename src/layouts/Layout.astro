---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  titleEn?: string;
  descEn?: string;
  keywordsEn?: string;
}

// 正式站点域名，canonical 与 og:url 都基于它生成绝对地址。
const SITE_URL = 'https://taosheng.app';

// 静态构建时 Astro.url.pathname 即当前页面的输出路径（如 /about/）。
const pagePath = Astro.url.pathname.replace(/\/index\.html$/, '/');

// Static fallbacks are Chinese; the client-side i18n store swaps in English.
const {
  title = '涛声 TaoSheng · 替你听，替你记，替你想',
  description = '涛声是开源的个人记忆工具：一部安卓手机全天收音、本地转写、声纹认人，AI 自动整理成待办、约定和记忆。不用买硬件、不用注册账号，数据只在你自己的手机里。',
  keywords = '涛声,TaoSheng,个人记忆,本地转写,声纹认人,AI 整理,安卓,开源,MIT,SenseVoice',
  canonical = new URL(pagePath, SITE_URL).href,
  titleEn = 'TaoSheng — It listens, remembers, and thinks for you',
  descEn = 'TaoSheng is an open-source personal memory tool for Android: all-day listening, on-device transcription, speaker recognition, and AI-organized todos, promises and memories. No hardware, no account, your data stays on your phone.',
  keywordsEn = 'TaoSheng,personal memory,on-device transcription,voiceprint,AI notes,Android,open source,MIT,SenseVoice',
} = Astro.props;

const pageMeta = JSON.stringify({
  zh: { title, description, keywords },
  en: { title: titleEn, description: descEn, keywords: keywordsEn },
});

const REPO = 'https://github.com/0xCoach/TaoSheng';
const RELEASES = `${REPO}/releases/latest`;
const README = `${REPO}/blob/main/README.md`;
const CHANGELOG = `${REPO}/blob/main/CHANGELOG.md`;
const CARDS = `${REPO}/tree/main/docs/任务卡`;
const LICENSE = `${REPO}/blob/main/LICENSE`;
---

<!DOCTYPE html>
<html lang="zh-CN" :lang="$store.i18n.lang === 'zh' ? 'zh-CN' : 'en'" x-data>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicon-256.png" rel="icon" sizes="256x256" type="image/png" />
    <link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/site.webmanifest" rel="manifest" />
    <meta name="theme-color" content="#F07B2E" />
    <meta name="generator" content={Astro.generator} />

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link href={canonical} rel="canonical" />

    <title>{title}</title>

    <meta content="website" property="og:type" />
    <meta content={canonical} property="og:url" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="/og-cover.jpg" property="og:image" />
    <meta content="涛声 TaoSheng" property="og:site_name" />
    <meta content="zh_CN" property="og:locale" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content="/og-cover.jpg" name="twitter:image" />

    <!-- Fonts: 异步加载，不阻塞首屏；加载失败回退系统字体栈 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      />
    </noscript>
  </head>
  <body class="flex flex-col antialiased bg-primary-50 min-h-screen pt-16 sm:pt-20 text-primary-950 transition duration-150" data-page-meta={pageMeta}>

    <!-- Header / Navbar -->
    <header
      class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-500"
      x-data="{ open: false, scrolled: false }"
      @scroll.window.passive="scrolled = window.scrollY > 8"
      @resize.window="if (window.innerWidth >= 640) open = false"
      @pageshow.window="open = false"
      x-effect="document.body.classList.toggle('overflow-hidden', open)"
      :class="open
        ? 'bg-primary-50'
        : (scrolled
          ? 'bg-primary-50/78 shadow-[0_1px_0_0_rgba(20,16,12,0.07)] backdrop-blur-xl'
          : 'bg-primary-50/0 backdrop-blur-0')"
    >
      <div
        class="mx-auto flex max-w-2xl items-center justify-between px-4 transition-all duration-500 ease-out-expo sm:px-6 lg:max-w-7xl lg:px-8"
        :class="scrolled ? 'py-2.5' : 'py-4'"
      >
        <div class="flex">
          <a class="items-center flex gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 rounded-md" href="/">
            <span class="sr-only" x-text="$store.i18n.t('header.brand')">涛声</span>
            <img alt="TaoSheng" class="w-auto h-8 rounded-lg" src="/logo.png" />
            <span class="text-primary-950 font-semibold text-xl" x-text="$store.i18n.t('header.brand')">涛声</span>
          </a>
        </div>

        <div class="items-center flex -mr-2 sm:space-x-5 space-x-2">
          <a class="text-base font-medium text-primary-950 hover:text-primary-600 transition-colors hidden sm:inline-flex" href="/" x-text="$store.i18n.t('nav.home')">首页</a>
          <a class="text-base font-medium text-primary-950 hover:text-primary-600 transition-colors hidden sm:inline-flex" href="/about" x-text="$store.i18n.t('nav.about')">关于</a>
          <a class="text-base font-medium text-primary-950 hover:text-primary-600 transition-colors hidden sm:inline-flex" href="/download" x-text="$store.i18n.t('nav.download')">下载</a>
          <a class="text-base font-medium text-primary-950 hover:text-primary-600 transition-colors hidden sm:inline-flex" href="/contact" x-text="$store.i18n.t('nav.contact')">联系</a>
          <!-- Download button -->
          <a class="items-center justify-center rounded-full font-semibold gap-2 transition bg-primary-900 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary-900 focus:outline-none hidden hover:bg-primary-800 px-5 py-2.5 shadow-sm sm:inline-flex text-sm text-white" href={RELEASES} rel="noopener noreferrer" target="_blank">
            <span x-text="$store.i18n.t('header.download')">下载 APK</span>
          </a>

          <!-- Language Toggle -->
          <button class="items-center justify-center rounded-full inline-flex transition focus-visible:ring-2 focus:outline-none h-14 hover:bg-primary-500/10 ring-primary-950 text-primary-950 w-14 gap-1" type="button" @click="$store.i18n.toggle()" aria-label="Toggle language">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="text-xs font-semibold" x-text="$store.i18n.lang === 'en' ? 'EN' : '中'">中</span>
          </button>

          <!-- Mobile Menu Toggle Button -->
          <button
            type="button"
            class="text-primary-950 hover:bg-primary-500/10 ring-primary-950 sm:hidden inline-flex h-14 w-14 items-center justify-center rounded-full transition focus:outline-none focus-visible:ring-2"
            @click="open = !open"
            @mousedown="if (open) $event.preventDefault()"
            aria-controls="website-menu"
            aria-expanded="false"
            :aria-expanded="open.toString()"
          >
            <span class="sr-only">Toggle menu</span>
            <svg x-cloak class="h-8 w-8" :class="{ 'hidden': open, 'block': !(open) }" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 8H5V10H19V8ZM19 14H5V16H19V14Z"></path>
            </svg>
            <svg x-cloak class="h-8 w-8" :class="{ 'block': open, 'hidden': !(open) }" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.0007 10.5865L16.9504 5.63672L18.3646 7.05093L13.4149 12.0007L18.3646 16.9504L16.9504 18.3646L12.0007 13.4149L7.05093 18.3646L5.63672 16.9504L10.5865 12.0007L5.63672 7.05093L7.05093 5.63672L12.0007 10.5865Z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu: 整屏不透明遮罩，背景直接铺满，进入动画只作用在内容上 -->
      <div
        id="website-menu"
        class="fixed inset-0 -z-10 overflow-y-auto overscroll-contain bg-primary-50 sm:hidden"
        x-cloak
        x-show="open"
      >
        <div
          class="mx-auto max-w-2xl px-4 pb-24 pt-28 sm:px-6"
          x-transition:enter="transition duration-300 ease-out-expo"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
        >
          <nav class="flex flex-col divide-primary-900/10 divide-y gap-1">
            <a class="font-medium text-primary-950 text-3xl tracking-tight sm:text-4xl focus-visible:outline-none group inline-flex py-6 sm:py-8 transition" href="/">
              <div class="items-center flex flex-1 group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 justify-between rounded-3xl">
                <div class="items-center flex gap-6">
                  <span class="text-xs">01</span>
                  <span class="group-hover:underline" x-text="$store.i18n.t('mobileMenu.home')">首页</span>
                </div>
                <svg class="text-primary-600 h-6 w-6 sm:h-8 sm:w-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
                </svg>
              </div>
            </a>
            <a class="font-medium text-primary-950 text-3xl tracking-tight sm:text-4xl focus-visible:outline-none group inline-flex py-6 sm:py-8 transition" href="/about">
              <div class="items-center flex flex-1 group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 justify-between rounded-3xl">
                <div class="items-center flex gap-6">
                  <span class="text-xs">02</span>
                  <span class="group-hover:underline" x-text="$store.i18n.t('mobileMenu.about')">关于</span>
                </div>
                <svg class="text-primary-600 h-6 w-6 sm:h-8 sm:w-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
                </svg>
              </div>
            </a>
            <a class="font-medium text-primary-950 text-3xl tracking-tight sm:text-4xl focus-visible:outline-none group inline-flex py-6 sm:py-8 transition" href="/download">
              <div class="items-center flex flex-1 group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 justify-between rounded-3xl">
                <div class="items-center flex gap-6">
                  <span class="text-xs">03</span>
                  <span class="group-hover:underline" x-text="$store.i18n.t('mobileMenu.download')">下载</span>
                </div>
                <svg class="text-primary-600 h-6 w-6 sm:h-8 sm:w-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
                </svg>
              </div>
            </a>
            <a class="font-medium text-primary-950 text-3xl tracking-tight sm:text-4xl focus-visible:outline-none group inline-flex py-6 sm:py-8 transition" href="/contact">
              <div class="items-center flex flex-1 group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 justify-between rounded-3xl">
                <div class="items-center flex gap-6">
                  <span class="text-xs">04</span>
                  <span class="group-hover:underline" x-text="$store.i18n.t('mobileMenu.contact')">联系</span>
                </div>
                <svg class="text-primary-600 h-6 w-6 sm:h-8 sm:w-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path>
                </svg>
              </div>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main Slot Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer aria-labelledby="footer-heading" class="mt-24 border-t border-primary-900/10 bg-primary-100 py-16 lg:py-20" id="footer">
      <h2 class="sr-only" id="footer-heading">Footer</h2>
      <div class="max-w-2xl lg:max-w-7xl lg:px-8 mx-auto px-4 sm:px-6">
        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[minmax(210px,1.3fr)_repeat(3,minmax(0,1fr))_auto] lg:gap-x-8 lg:items-start xl:gap-x-12">
            <div class="flex flex-col gap-6 sm:col-span-2 lg:col-span-1">
              <div class="flex h-10 items-center gap-3">
                <img alt="TaoSheng" class="h-10 rounded-lg w-10" src="/logo.png" />
                <span class="text-primary-950 text-xl font-bold" x-text="$store.i18n.t('footer.brand')">涛声 TaoSheng</span>
              </div>
              <p class="text-sm text-primary-950/70 leading-relaxed max-w-xs" x-text="$store.i18n.t('footer.desc')">替你听，替你记，替你想。开源的个人记忆工具，数据只在你自己的手机里。</p>
            </div>

              <div class="flex flex-col gap-4">
                <h3 class="flex h-10 items-center text-sm text-primary-950 font-semibold tracking-wider uppercase" x-text="$store.i18n.t('footer.community')">社区</h3>
                <ul class="flex flex-col gap-2.5" role="list">
                  <li>
                    <button class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors cursor-pointer" type="button" aria-controls="update-modal" aria-haspopup="dialog" data-modal-target="update-modal">
                      <span class="group-hover:underline" x-text="$store.i18n.t('footer.updateModal.title')">获取最新版涛声</span>
                    </button>
                  </li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={REPO} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.github')">GitHub 仓库</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={`${REPO}/issues`} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.issues')">问题反馈</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={`${REPO}/issues`} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.discussions')">提问与讨论</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={`${REPO}/pulls`} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.pullRequests')">代码贡献</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={REPO} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.stargazers')">点个 Star</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                </ul>
              </div>

              <div class="flex flex-col gap-4">
                <h3 class="flex h-10 items-center text-sm text-primary-950 font-semibold tracking-wider uppercase" x-text="$store.i18n.t('footer.resources')">资源</h3>
                <ul class="flex flex-col gap-2.5" role="list">
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={RELEASES} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.downloadApk')">下载安装包</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
                  <li><a class="items-center inline-flex focus-visible:outline focus-visible:outline-2 duration-200 focus-visible:outline-primary-950 gap-1.5 group hover:text-primary-950 rounded-md text-primary-950/70 text-sm transition-colors" href={README} rel="noopener noreferrer" target="_blank">
                    <span class="group-hover:underline" x-text="$store.i18n.t('footer.docs')">使用说明</span>
                    <svg class="h-3.5 w-3.5 group-hover:opacity-100 opacity-50 transition-opacity" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path></svg>
                  </a></li>
