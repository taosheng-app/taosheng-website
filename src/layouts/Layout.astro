    <!-- Modal Logic Script -->
    <script is:inline>
      function initModals() {
        const targets = document.querySelectorAll("[data-modal-target]");
        const closes = document.querySelectorAll("[data-modal-close]");

        const closeModal = (id) => {
          const el = document.getElementById(id);
          if (el) {
            el.classList.add("hidden");
            el.classList.remove("flex");
            document.body.style.overflow = "";
            document.body.style.paddingRight = "";
          }
        };

        const openModal = (id) => {
          const el = document.getElementById(id);
          if (!el) return;
          const scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
          el.classList.remove("hidden");
          el.classList.add("flex");
          document.body.style.overflow = "hidden";
          if (scrollBarWidth > 0) {
            document.body.style.paddingRight = `${scrollBarWidth}px`;
          }
        };

        targets.forEach(el => {
          if (el.dataset.modalBound !== "true") {
            el.dataset.modalBound = "true";
            el.addEventListener("click", () => {
              const target = el.getAttribute("data-modal-target");
              if (target) openModal(target);
            });
          }
        });

        closes.forEach(el => {
          if (el.dataset.modalBound !== "true") {
            el.dataset.modalBound = "true";
            el.addEventListener("click", () => {
              const target = el.getAttribute("data-modal-close");
              if (target) closeModal(target);
            });
          }
        });

        document.querySelectorAll('[role="dialog"][aria-modal="true"]').forEach(el => {
          if (el.dataset.modalOverlayBound !== "true") {
            el.dataset.modalOverlayBound = "true";
            el.addEventListener("click", (e) => {
              if (e.target === el && el.id) closeModal(el.id);
            });
          }
        });

        if (document.body.dataset.footerModalEscBound !== "true") {
          document.body.dataset.footerModalEscBound = "true";
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
              document.querySelectorAll('[role="dialog"][aria-modal="true"]').forEach(modal => {
                if (!modal.classList.contains("hidden") && modal.id) closeModal(modal.id);
              });
            }
          });
        }
      }
      document.addEventListener("DOMContentLoaded", initModals);
      document.addEventListener("astro:page-load", initModals);
    </script>

    <!-- i18n Alpine.js Client Bootloader -->
    <script>
      import Alpine from 'alpinejs';
      import { translations } from '../i18n/translations';

      if (!window.Alpine) {
        Alpine.store('i18n', {
          lang: 'zh',
          init() {
            const saved = localStorage.getItem('lang');
            const browser = (navigator.language || '').toLowerCase();
            this.lang = saved || (browser.startsWith('zh') ? 'zh' : 'en');
          },
          toggle() {
            this.lang = this.lang === 'en' ? 'zh' : 'en';
            localStorage.setItem('lang', this.lang);
          },
          t(key) {
            const keys = key.split('.');
            let result = translations[this.lang];
            for (const k of keys) {
              if (result && typeof result === 'object' && k in result) {
                result = result[k];
              } else {
                return key;
              }
            }
            return result;
          }
        });

        window.Alpine = Alpine;
        Alpine.start();

        // Keep <title>, meta description and Open Graph tags in sync with the language.
        const setMeta = (attr, value, content) => {
          const el = document.querySelector(`meta[${attr}="${value}"]`);
          if (el) el.setAttribute('content', content);
        };

        Alpine.effect(() => {
          const lang = Alpine.store('i18n').lang;
          document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
          const siteMeta = translations[lang].meta;
          setMeta('property', 'og:site_name', siteMeta.ogSiteName);
          setMeta('property', 'og:locale', siteMeta.ogLocale);

          const raw = document.body && document.body.dataset.pageMeta;
          if (!raw) return;
          try {
            const m = JSON.parse(raw)[lang];
            if (!m) return;
            if (m.title) {
              document.title = m.title;
              setMeta('property', 'og:title', m.title);
              setMeta('name', 'twitter:title', m.title);
            }
            if (m.description) {
              setMeta('name', 'description', m.description);
              setMeta('property', 'og:description', m.description);
              setMeta('name', 'twitter:description', m.description);
            }
            if (m.keywords) setMeta('name', 'keywords', m.keywords);
          } catch (e) {
            // Ignore malformed metadata; the server-rendered Chinese fallback stays.
          }
        });
      }
    </script>

    <script>
      // 滚动进场：进入视口后淡入上移，每个元素只执行一次。
      const initReveal = () => {
        const items = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!items.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        items.forEach((el) => io.observe(el));
      };

      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
