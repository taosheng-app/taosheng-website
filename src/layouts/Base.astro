---
import '../styles/global.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import { ui, pathFor, type Lang } from '../data/i18n';
import { getRelease, mb, APK_DOWNLOAD, REPO } from '../data/release';

interface Props {
  lang: Lang;
  path: string; // 不含 /en 前缀的路径，如 "/"、"/guide"
  title: string;
  description: string;
  stars?: boolean;
}
const { lang, path, title, description, stars = false } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const SITE = 'https://taosheng.app';
const canonical = new URL(pathFor(lang, path), SITE).href;
const alt = new URL(pathFor(other, path), SITE).href;
const zhHref = new URL(pathFor('zh', path), SITE).href;
const enHref = new URL(pathFor('en', path), SITE).href;
const r = await getRelease();
const l = (p: string) => pathFor(lang, p);
const navItems = [
  { href: l('/') + '#day', label: t.nav.day },
  { href: l('/') + '#privacy', label: t.nav.privacy },
  { href: l('/guide'), label: t.nav.guide },
  { href: l('/download'), label: t.nav.install },
  { href: l('/about'), label: t.nav.about },
];
const f = t.footer;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <meta name="theme-color" content="#f6f2ec" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'zh' ? '涛声 TaoSheng' : 'TaoSheng'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og-cover.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: lang === 'zh' ? '涛声' : 'TaoSheng',
        alternateName: 'TaoSheng',
        operatingSystem: 'Android 10+',
        applicationCategory: 'ProductivityApplication',
        softwareVersion: r.version,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
        downloadUrl: `${SITE}${APK_DOWNLOAD}`,
        url: canonical,
      })}
    />
  </head>
  <body data-lang={lang}>
    {stars && <div class="stars" aria-hidden="true"></div>}

    <header class="site-nav fixed inset-x-0 top-0 z-50 pt-[env(safe-area-inset-top)]">
      <div class="nav-bar wrap flex h-16 items-center gap-6">
        <a href={l('/')} class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label={t.brand}>
          <img src="/logo.svg" alt="" width="30" height="30" class="rounded-[9px]" />
          <span class="text-[17px]">{t.brand}</span>
        </a>
        <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Main">
          {navItems.map((n) => <a href={n.href} class="nav-link">{n.label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <a href={pathFor(other, path)} class="nav-link text-[13px] font-semibold" hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'} aria-label={t.langLabel}>{t.langSwitch}</a>
          <a href={APK_DOWNLOAD} data-download class="btn btn-primary hidden h-10 px-5 text-sm sm:inline-flex">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {t.downloadShort}
          </a>
          <button class="nav-toggle grid h-10 w-10 place-items-center rounded-full lg:hidden" aria-label="Menu" aria-expanded="false" data-menu-btn>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
      <div class="mobile-menu wrap hidden pb-6 lg:hidden" data-menu>
        <nav class="flex flex-col" aria-label="Mobile">
          {navItems.map((n) => <a href={n.href} class="border-b py-4 text-2xl font-semibold tracking-tight phase-line" style="border-color:var(--nav-line)">{n.label}</a>)}
        </nav>
        <a href={APK_DOWNLOAD} data-download class="btn btn-accent mt-6 h-14 w-full text-base">{t.download}</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="relative z-10 border-t phase-line" style="border-color:var(--color-line)">
      <div class="wrap grid gap-12 py-16 md:grid-cols-[1.3fr_2fr]">
        <div>
          <a href={l('/')} class="flex items-center gap-2.5 font-semibold">
            <img src="/logo.svg" alt="" width="34" height="34" class="rounded-[10px]" />
            <span class="text-lg">{lang === 'zh' ? '涛声 TaoSheng' : 'TaoSheng'}</span>
          </a>
          <p class="mt-5 text-xl font-semibold tracking-tight phase-ink">{f.tagline}</p>
          <p class="mt-3 max-w-sm text-sm leading-7 text-[var(--color-ink-3)] phase-dim">{f.desc}</p>
          <a href={APK_DOWNLOAD} data-download class="btn btn-primary mt-7 h-11 px-6 text-sm">
            {t.download}
          </a>
          <p class="mt-3 text-xs text-[var(--color-ink-3)] phase-dim" data-release-meta>{t.meta(r.version, mb(r.size))}</p>
        </div>
        <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-4">
          <div>
            <p class="mb-4 font-semibold phase-ink">{f.product}</p>
            <ul class="space-y-3 text-[var(--color-ink-2)] phase-dim">
              <li><a class="hover:text-[var(--color-accent)]" href={l('/download')}>{f.install}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">{f.changelog}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={`${REPO}/blob/main/docs/%E7%A1%AC%E4%BB%B6%E6%8E%A5%E5%85%A5%E4%B8%8E%E5%8D%8F%E8%AE%AE%E9%80%82%E9%85%8D.md`} target="_blank" rel="noopener">{f.hardware}</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-4 font-semibold phase-ink">{f.learn}</p>
            <ul class="space-y-3 text-[var(--color-ink-2)] phase-dim">
              <li><a class="hover:text-[var(--color-accent)]" href={l('/guide')}>{f.guide}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={l('/') + '#faq'}>{f.faq}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={l('/about')}>{t.nav.about}</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-4 font-semibold phase-ink">{f.community}</p>
            <ul class="space-y-3 text-[var(--color-ink-2)] phase-dim">
              <li><a class="hover:text-[var(--color-accent)]" href={REPO} target="_blank" rel="noopener">{f.github}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={`${REPO}/issues`} target="_blank" rel="noopener">{f.issues}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={`${REPO}/stargazers`} target="_blank" rel="noopener">{f.star}</a></li>
            </ul>
          </div>
          <div>
            <p class="mb-4 font-semibold phase-ink">{f.legal}</p>
            <ul class="space-y-3 text-[var(--color-ink-2)] phase-dim">
              <li><a class="hover:text-[var(--color-accent)]" href={l('/privacy')}>{f.privacy}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={l('/terms')}>{f.terms}</a></li>
              <li><a class="hover:text-[var(--color-accent)]" href={`${REPO}/blob/main/LICENSE.md`} target="_blank" rel="noopener">{f.license}</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="wrap flex flex-col gap-2 border-t py-6 text-xs text-[var(--color-ink-3)] sm:flex-row sm:justify-between phase-line phase-dim" style="border-color:var(--color-line)">
        <span>© 2026 TaoSheng · {f.bottom}</span>
        <span>taosheng.app</span>
      </div>
    </footer>

    <!-- 微信 / QQ 等内置浏览器下载提示 -->
    <div class="wx-mask" data-wx hidden>
      <svg class="wx-arrow" width="90" height="90" viewBox="0 0 90 90" fill="none" aria-hidden="true"><path d="M14 80C30 50 50 28 78 12m0 0l-18 2m18-2l-4 17" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="wx-card" role="dialog" aria-modal="true" aria-labelledby="wx-title">
        <p id="wx-title" class="text-lg font-semibold">{t.wechatTitle}</p>
        <p class="mt-2 text-sm leading-6 text-[var(--color-ink-2)]">{t.wechatBody}</p>
        <div class="mt-5 flex gap-2">
          <button class="btn btn-ghost h-11 flex-1 text-sm" data-wx-copy data-done={t.wechatCopied}>{t.wechatCopy}</button>
          <button class="btn btn-primary h-11 flex-1 text-sm" data-wx-close>{t.close}</button>
        </div>
      </div>
    </div>

    {lang === 'zh' && (
      <div class="lang-hint" data-lang-hint hidden>
        <a href={pathFor('en', path)} hreflang="en" lang="en">{ui.zh.langHintGo} →</a>
        <button aria-label="Close" data-lang-hint-close>×</button>
      </div>
    )}

    <style>
      .site-nav {
        --nav-bg: rgba(246, 242, 236, 0.72);
        --nav-ink: var(--color-ink);
        --nav-line: rgba(29, 27, 25, 0.08);
        color: var(--nav-ink);
        transition: background-color 0.6s, color 0.9s;
      }
      :global(body[data-phase="night"]) .site-nav { --nav-bg: rgba(13, 11, 23, 0.72); --nav-ink: #ece8f4; --nav-line: rgba(255, 255, 255, 0.08); }
      .site-nav.scrolled, .site-nav.open {
        background: var(--nav-bg);
        backdrop-filter: saturate(1.6) blur(18px);
        -webkit-backdrop-filter: saturate(1.6) blur(18px);
        box-shadow: 0 1px 0 var(--nav-line);
      }
      .nav-link {
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 14.5px;
        font-weight: 500;
        opacity: 0.78;
        transition: opacity 0.2s, background-color 0.2s;
      }
      .nav-link:hover { opacity: 1; background: color-mix(in srgb, currentColor 7%, transparent); }
      .nav-toggle:hover { background: color-mix(in srgb, currentColor 7%, transparent); }
      .site-nav.open [data-menu] { display: block; }
      .wx-mask {
        position: fixed; inset: 0; z-index: 100;
        background: rgba(10, 8, 6, 0.72);
        backdrop-filter: blur(4px);
        display: flex; align-items: flex-end; justify-content: center;
        padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
      }
      .wx-mask[hidden] { display: none; }
      .wx-arrow { position: absolute; top: 8px; right: 18px; }
      .wx-card { width: 100%; max-width: 420px; background: #fff; border-radius: 24px; padding: 22px; color: var(--color-ink); }
      .lang-hint {
        position: fixed; left: 50%; bottom: 20px; z-index: 60; transform: translateX(-50%);
        display: flex; align-items: center; gap: 6px;
        padding: 6px 6px 6px 16px; border-radius: 999px;
        background: var(--color-ink); color: #fff; font-size: 13px; font-weight: 600;
        box-shadow: 0 20px 40px -20px rgba(0,0,0,.6);
      }
      .lang-hint[hidden] { display: none; }
      .lang-hint button { width: 28px; height: 28px; border-radius: 50%; font-size: 18px; line-height: 1; opacity: .7; }
      .lang-hint button:hover { opacity: 1; background: rgba(255,255,255,.12); }
    </style>

    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
