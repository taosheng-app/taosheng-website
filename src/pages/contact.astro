---
import Layout from '../layouts/Layout.astro';

const REPO = 'https://github.com/0xCoach/TaoSheng';
const README = `${REPO}/blob/main/README.md`;
const RELEASES = `${REPO}/releases/latest`;
---

<Layout
  title="联系我们 · 涛声 TaoSheng"
  titleEn="Contact — TaoSheng"
  description="通过 GitHub Issues、Discussions、使用文档与 Releases 联系涛声项目，反馈机型问题或获取最新安装包。"
  descEn="Reach the TaoSheng project through GitHub Issues, Discussions, the README and Releases. Report device-specific problems or grab the latest APK."
  keywords="涛声,联系,反馈,GitHub Issues,机型反馈"
  keywordsEn="TaoSheng,contact,feedback,GitHub Issues,device report"
>
  <section class="py-16 sm:py-20">
    <div class="px-4 lg:max-w-7xl lg:px-8 max-w-2xl mx-auto sm:px-6">
      <!-- Header -->
      <div class="flex flex-col gap-4 text-center pb-16 sm:pb-20">
        <h1 class="font-medium tracking-tight sm:text-5xl text-4xl" x-text="$store.i18n.t('contact.title')">联系我们</h1>
        <p class="text-base text-primary-950/60 max-w-2xl mx-auto" x-text="$store.i18n.t('contact.subtitle')">有问题、有想法，或在你的机型上遇到 Bug？欢迎通过以下方式联系。</p>
      </div>

      <!-- Contact Methods -->
      <div class="max-w-3xl mx-auto">
        <div class="grid gap-6 sm:grid-cols-2">
          <!-- GitHub Issues -->
          <a class="flex flex-col gap-4 p-6 bg-white border border-primary-900/10 rounded-2xl hover:border-primary-600/30 transition-colors group" href={`${REPO}/issues`} rel="noopener noreferrer" target="_blank">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center h-12 w-12 rounded-xl bg-primary-600/10">
                <svg class="h-6 w-6 text-primary-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-primary-950 group-hover:underline" x-text="$store.i18n.t('contact.issuesTitle')">GitHub Issues</h3>
                <p class="text-sm text-primary-950/60" x-text="$store.i18n.t('contact.issuesSub')">提交 Bug 与机型反馈</p>
              </div>
            </div>
            <p class="text-sm text-primary-950/70" x-text="$store.i18n.t('contact.issuesDesc')">闪退、后台被杀、功能建议都可以提 Issue。附上机型和系统版本，定位会快很多。</p>
            <div class="flex items-center gap-1.5 text-sm text-primary-600 mt-auto">
              <span x-text="$store.i18n.t('contact.issuesLink')">提交 Issue</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>

          <!-- GitHub Discussions -->
          <a class="flex flex-col gap-4 p-6 bg-white border border-primary-900/10 rounded-2xl hover:border-primary-600/30 transition-colors group" href={`${REPO}/issues`} rel="noopener noreferrer" target="_blank">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center h-12 w-12 rounded-xl bg-blue-500/10">
                <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-primary-950 group-hover:underline" x-text="$store.i18n.t('contact.discussionsTitle')">提问与交流</h3>
                <p class="text-sm text-primary-950/60" x-text="$store.i18n.t('contact.discussionsSub')">在 Issues 里提问</p>
              </div>
            </div>
            <p class="text-sm text-primary-950/70" x-text="$store.i18n.t('contact.discussionsDesc')">提问、分享用法，或交流模型服务商和自定义技能的搭配。</p>
            <div class="flex items-center gap-1.5 text-sm text-primary-600 mt-auto">
              <span x-text="$store.i18n.t('contact.discussionsLink')">去提问</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>

          <!-- Documentation -->
          <a class="flex flex-col gap-4 p-6 bg-white border border-primary-900/10 rounded-2xl hover:border-primary-600/30 transition-colors group" href={README} rel="noopener noreferrer" target="_blank">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center h-12 w-12 rounded-xl bg-green-500/10">
                <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-primary-950 group-hover:underline" x-text="$store.i18n.t('contact.docsTitle')">使用文档</h3>
                <p class="text-sm text-primary-950/60" x-text="$store.i18n.t('contact.docsSub')">快速开始与日常使用</p>
              </div>
            </div>
            <p class="text-sm text-primary-950/70" x-text="$store.i18n.t('contact.docsDesc')">README 里有准备步骤、首次使用引导、自定义技能写法和完整架构说明。</p>
            <div class="flex items-center gap-1.5 text-sm text-primary-600 mt-auto">
              <span x-text="$store.i18n.t('contact.docsLink')">阅读 README</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>

          <!-- Releases -->
          <a class="flex flex-col gap-4 p-6 bg-white border border-primary-900/10 rounded-2xl hover:border-primary-600/30 transition-colors group" href={RELEASES} rel="noopener noreferrer" target="_blank">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center h-12 w-12 rounded-xl bg-orange-500/10">
                <svg class="h-6 w-6 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 3.5v11m0 0l-4-4m4 4l4-4M4 16.5v2A2.5 2.5 0 006.5 21h11a2.5 2.5 0 002.5-2.5v-2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-primary-950 group-hover:underline" x-text="$store.i18n.t('contact.releasesTitle')">Releases</h3>
                <p class="text-sm text-primary-950/60" x-text="$store.i18n.t('contact.releasesSub')">安装包、更新日志与校验</p>
              </div>
            </div>
            <p class="text-sm text-primary-950/70" x-text="$store.i18n.t('contact.releasesDesc')">每个正式签名版本、更新说明和 SHA-256 校验文件都在 GitHub Releases 发布。</p>
            <div class="flex items-center gap-1.5 text-sm text-primary-600 mt-auto">
              <span x-text="$store.i18n.t('contact.releasesLink')">查看 Releases</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>
        </div>

        <!-- Additional Info -->
        <div class="mt-16 text-center">
          <div class="inline-flex items-center gap-2 px-6 py-3 bg-primary-500/5 rounded-full">
            <svg class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="text-sm text-primary-950/70" x-text="$store.i18n.t('contact.responseTime')">项目由个人维护，回复可能不及时，敬请谅解。</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
