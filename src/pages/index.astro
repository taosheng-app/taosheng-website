---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { MODELSCOPE_RELEASES } from '../config/release';

import askShot from '../assets/ask.jpg';
import configShot from '../assets/config.jpg';
import memoryShot from '../assets/memory.jpg';
import todayShot from '../assets/today.jpg';
import todoShot from '../assets/todo.jpg';

const REPO = 'https://github.com/0xCoach/TaoSheng';
const RELEASES = `${REPO}/releases/latest`;

// Order follows the in-app bottom navigation: 今天 → 问问 → 记忆 → 待办 → 设置
const shots = [
  { src: todayShot, alt: '涛声「今天」页：正在聆听、今日录到的声音与待确认事项' },
  { src: askShot, alt: '涛声「问问」页：提问后给出答案，并标注原话出处' },
  { src: memoryShot, alt: '涛声「记忆」页：日历回顾、会议速记卡片与时间线' },
  { src: todoShot, alt: '涛声「待办」页：从日常对话里整理出的待办清单' },
  { src: configShot, alt: '涛声「设置」页：录音、转写、模型与声纹配置' },
];

// 首屏声波：用确定性公式生成，保证每次构建结果一致
const waveform = Array.from({ length: 26 }, (_, i) => {
  const base = Math.sin(i * 0.82) * 0.5 + 0.5;
  const detail = Math.sin(i * 2.6 + 1.3) * 0.24;
  const height = Math.round(18 + (base + detail) * 78);
  return {
    height: Math.min(100, Math.max(14, height)),
    delay: Number((i * 0.083).toFixed(3)),
    duration: Number((1.1 + ((i * 7) % 5) * 0.17).toFixed(2)),
  };
});
---

<Layout>
  <section class="relative overflow-hidden pb-20 pt-10 sm:pb-28 sm:pt-16">
    <!-- 背景层：暖色光晕 + 细网格 -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="halo -left-[20%] -top-[18%] h-[340px] w-[340px] animate-halo bg-brand-300/30 opacity-70 sm:-left-[14%] sm:-top-[28%] sm:h-[560px] sm:w-[560px] sm:opacity-100"></div>
      <div class="halo -right-[16%] top-[2%] h-[260px] w-[260px] animate-halo bg-brand-200/35 opacity-70 sm:-right-[10%] sm:top-[4%] sm:h-[460px] sm:w-[460px] sm:opacity-100" style="animation-delay:-7s"></div>
      <div
        class="absolute inset-0"
        style="background-image:linear-gradient(to right,rgba(20,16,12,0.04) 1px,transparent 1px),linear-gradient(to bottom,rgba(20,16,12,0.04) 1px,transparent 1px);background-size:88px 88px;mask-image:radial-gradient(ellipse 95% 75% at 50% -8%,#000 15%,transparent 72%);-webkit-mask-image:radial-gradient(ellipse 95% 75% at 50% -8%,#000 15%,transparent 72%)"
      ></div>
    </div>

    <div class="mx-auto grid max-w-2xl items-center gap-14 px-4 pt-8 sm:px-6 sm:pt-12 lg:max-w-7xl lg:grid-cols-[1.06fr_0.94fr] lg:gap-16 lg:px-8">
      <div class="flex flex-col gap-9">
        <div class="flex flex-col gap-6">
          <p class="reveal inline-flex items-center gap-2.5 text-eyebrow text-brand-700">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-500 opacity-70"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
            </span>
            <span x-text="$store.i18n.t('index.badge')">开源 · 本地优先</span>
          </p>
          <h1 class="reveal text-display text-balance text-primary-950" style="--reveal-delay:60ms">
            <span x-text="$store.i18n.t('index.title')">说过的话，都替你记着</span>
          </h1>
          <p
            class="reveal max-w-[32rem] text-pretty text-[1.05rem] leading-[1.85] text-primary-950/[0.68] sm:text-[1.22rem]"
            style="--reveal-delay:120ms"
          >
            <span x-text="$store.i18n.t('index.subtitle')">一部安卓手机就够：全天收音 → 自动转写 → 认出谁在说 → AI 整理成待办、约定和记忆。不用买硬件，不用注册账号。</span>
          </p>
        </div>

        <div class="reveal flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:items-center" style="--reveal-delay:180ms">
          <a
            class="group relative inline-flex w-full items-center justify-center overflow-hidden rounded-full bg-primary-950 px-7 py-4 text-base font-semibold text-primary-50 shadow-[0_1px_2px_rgba(20,16,12,0.18),0_14px_30px_-16px_rgba(20,16,12,0.55)] transition-all duration-500 ease-out-expo hover:-translate-y-0.5 hover:shadow-[0_2px_4px_rgba(20,16,12,0.18),0_22px_44px_-18px_rgba(240,123,46,0.6)] sm:w-auto"
            href={RELEASES}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="relative z-10" x-text="$store.i18n.t('index.download')">下载 APK</span>
            <span
              class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 ease-out-expo group-hover:translate-x-full"
              aria-hidden="true"></span>
          </a>
          <a
            class="group inline-flex w-full items-center justify-center gap-2 rounded-full border border-primary-900/12 bg-white/60 px-6 py-4 text-base font-semibold text-primary-950 backdrop-blur-sm transition-all duration-500 ease-out-expo hover:-translate-y-0.5 hover:border-primary-900/20 hover:bg-white hover:shadow-[0_14px_30px_-18px_rgba(20,16,12,0.35)] sm:w-auto"
            href={REPO}
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg
              class="h-5 w-5 text-primary-500 transition-transform duration-500 ease-spring group-hover:rotate-12 group-hover:text-brand-600"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z"></path>
            </svg>
            <span x-text="$store.i18n.t('index.viewSource')">查看源码</span>
          </a>

          <a
            class="group inline-flex items-center justify-center gap-1.5 rounded-full px-2 py-1 text-sm font-medium text-primary-950/50 underline decoration-primary-950/20 underline-offset-4 transition-colors duration-300 hover:text-primary-950 hover:decoration-primary-950/45 sm:ml-1.5 sm:px-1"
            href={MODELSCOPE_RELEASES}
            rel="noopener noreferrer"
            target="_blank"
            title="国内下载镜像"
          >
            <span x-text="$store.i18n.t('index.mirror')">国内镜像：魔搭</span>
            <svg
              class="h-3 w-3 shrink-0 transition-transform duration-300 ease-out-expo group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H9M17 7v8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <p class="reveal flex items-start gap-3 text-sm leading-6 text-primary-950/50" style="--reveal-delay:240ms">
          <span class="mt-3 h-px w-7 shrink-0 bg-primary-900/20" aria-hidden="true"></span>
          <span class="max-w-xl" x-text="$store.i18n.t('index.workflowHint')">手机在后台安静地听，有人说话才录；要找的时候，打字问一句就能找回来。</span>
        </p>
      </div>

      <div
        class="reveal relative"
        style="--reveal-delay:200ms; perspective: 1200px"
        x-data="{ rx: 0, ry: 0 }"
        @mousemove="if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          const r = $el.getBoundingClientRect();
          ry = (($event.clientX - r.left) / r.width - 0.5) * 7;
          rx = (($event.clientY - r.top) / r.height - 0.5) * -7;
        }"
        @mouseleave="rx = 0; ry = 0"
      >
        <div
          class="pointer-events-none absolute -inset-8 -z-10 rounded-[3rem] bg-gradient-to-br from-brand-300/35 via-brand-100/25 to-transparent blur-2xl"
          aria-hidden="true"
        ></div>

        <div
          class="group relative rounded-[2.2rem] border border-white/70 bg-white/75 p-2.5 shadow-[0_2px_6px_rgba(20,16,12,0.05),0_34px_64px_-32px_rgba(20,16,12,0.32)] backdrop-blur-xl transition-[transform,box-shadow] duration-500 ease-out-expo hover:shadow-[0_2px_8px_rgba(20,16,12,0.06),0_44px_80px_-34px_rgba(20,16,12,0.38)] sm:p-3"
          :style="`transform: rotateX(${rx}deg) rotateY(${ry}deg)`"
        >
          <div class="grain overflow-hidden rounded-[1.85rem] bg-gradient-to-b from-white to-primary-50 p-5 ring-1 ring-primary-900/6 sm:p-6">
            <div class="grain-layer"></div>
            <div class="relative z-10">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-[15px] font-semibold tracking-tight text-primary-950">TaoSheng</p>
                  <p class="mt-1 text-xs text-primary-950/50" x-text="$store.i18n.t('index.workflowLocal')">今天 · 原话</p>
                </div>
                <div class="flex h-10 items-end gap-[2.5px]" aria-hidden="true">
                  {waveform.map((bar) => (
                    <span
                      class="w-[2.5px] origin-bottom rounded-full bg-gradient-to-t from-brand-400 to-brand-600"
                      style={`height:${bar.height}%;animation:wave ${bar.duration}s ease-in-out infinite;animation-delay:${bar.delay}s`}
                    ></span>
                  ))}
                </div>
              </div>

              <div class="mt-6 rounded-2xl bg-white/90 p-4 shadow-[0_1px_2px_rgba(20,16,12,0.04)] ring-1 ring-primary-900/8">
                <div class="mb-2.5 flex items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-900/5 px-2 py-0.5 text-[11px] font-medium text-primary-700">
                    <span class="h-1 w-1 rounded-full bg-brand-500" aria-hidden="true"></span>
                    <span x-text="$store.i18n.t('index.workflowSpeaker')">我</span>
                  </span>
                  <span class="text-[11px] tabular-nums text-primary-950/35">14:32</span>
                </div>
                <p class="text-[15px] leading-[1.9] text-primary-950/75" x-text="$store.i18n.t('index.workflowRaw')">下周三之前把报价单发给老王，对了，钥匙放在玄关第二个抽屉了。</p>
              </div>

              <div class="mt-4 flex items-center gap-3 rounded-2xl bg-brand-tint-strong px-4 py-3.5 ring-1 ring-brand-700/15">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white ring-1 ring-brand-600/15">
                  <svg class="h-4 w-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                    <path d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-semibold leading-snug text-primary-950" x-text="$store.i18n.t('index.workflowDraft')">涛声整理出 1 条待办和 1 条记忆</p>
                  <p class="mt-1 text-xs leading-snug text-brand-800/70" x-text="$store.i18n.t('index.step3Desc')">每条都能点回当时的原话。</p>
                </div>
              </div>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/10 px-3 py-1 text-[11.5px] font-medium text-brand-700 ring-1 ring-brand-600/15">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M4.5 12.75l6 6 9-13.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  <span x-text="$store.i18n.t('index.workflowTagTodo')">待办 · 今天</span>
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-primary-900/[0.055] px-3 py-1 text-[11.5px] font-medium text-primary-700 ring-1 ring-primary-900/10">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  <span x-text="$store.i18n.t('index.workflowTagMemory')">记忆 · 玄关</span>
                </span>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative pb-24 sm:pb-32" aria-label="涛声 App 界面截图">
    <div
      class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8"
      x-data="{
        active: 0,
        paused: false,
        timer: null,
        raf: null,
        step() {
          const track = this.$refs.track;
          if (!track || !track.children.length) return 0;
          const gap = parseFloat(window.getComputedStyle(track).columnGap) || 0;
          return track.children[0].getBoundingClientRect().width + gap;
        },
        go(index) {
          const track = this.$refs.track;
          if (!track) return;
          const target = Math.max(0, Math.min(track.children.length - 1, index));
          this.active = target;
          const max = track.scrollWidth - track.clientWidth;
          const end = Math.min(target * this.step(), max);
          const start = track.scrollLeft;
          const delta = end - start;
          if (this.raf) cancelAnimationFrame(this.raf);
          this.raf = null;
          if (!delta) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            track.scrollLeft = end;
            return;
          }
          const duration = 420;
          const started = performance.now();
          const ease = (t) => 1 - Math.pow(1 - t, 3);
          const tick = (now) => {
            const p = Math.min(1, (now - started) / duration);
            track.scrollLeft = start + delta * ease(p);
            this.raf = p < 1 ? requestAnimationFrame(tick) : null;
          };
          this.raf = requestAnimationFrame(tick);
        },
        next() {
          const track = this.$refs.track;
          if (!track) return;
          this.go(this.active >= track.children.length - 1 ? 0 : this.active + 1);
          this.restart();
        },
        prev() {
          const track = this.$refs.track;
          if (!track) return;
          this.go(this.active <= 0 ? track.children.length - 1 : this.active - 1);
          this.restart();
        },
        autoAdvance() {
          if (this.paused || document.hidden) return;
          const track = this.$refs.track;
          if (!track) return;
          this.go(this.active >= track.children.length - 1 ? 0 : this.active + 1);
        },
        restart() {
          if (!this.timer) return;
          clearInterval(this.timer);
          this.timer = setInterval(() => this.autoAdvance(), 5000);
        },
        sync() {
          const track = this.$refs.track;
          if (!track) return;
          const trackLeft = track.getBoundingClientRect().left;
          let nearest = 0;
          let distance = Infinity;
          Array.prototype.forEach.call(track.children, (child, i) => {
            const gap = Math.abs(child.getBoundingClientRect().left - trackLeft);
            if (gap < distance) {
              distance = gap;
              nearest = i;
            }
          });
          this.active = nearest;
        },
        init() {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
          if (reduceMotion || !finePointer) return;
          this.timer = setInterval(() => this.autoAdvance(), 5000);
        },
        destroy() {
          if (this.timer) clearInterval(this.timer);
          if (this.raf) cancelAnimationFrame(this.raf);
        }
      }"
      @mouseenter="paused = true"
      @mouseleave="paused = false"
      @focusin="paused = true"
      @focusout="paused = false"
    >
      <div class="reveal mb-10 flex flex-col gap-5 sm:mb-14 sm:flex-row sm:items-end sm:justify-between sm:gap-12">
        <div class="max-w-lg">
          <p class="text-eyebrow text-brand-700" x-text="$store.i18n.t('index.shotsEyebrow')">界面一览</p>
          <h2 class="mt-4 text-balance text-[1.7rem] font-bold leading-[1.15] tracking-[-0.03em] text-primary-950 sm:text-[2.15rem]" x-text="$store.i18n.t('index.shotsTitle')">每一屏，都有明确分工</h2>
        </div>
        <p
          class="max-w-sm text-[15px] leading-[1.8] text-primary-950/55 sm:pb-1.5"
          x-text="$store.i18n.t('index.shotsDesc')"
        >
          今天、问问、记忆、待办：从说出口到找回来，路径短到不用想。
        </p>
      </div>

      <div
        class="flex gap-5 overflow-x-auto pb-3 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        x-ref="track"
        role="group"
        aria-roledescription="carousel"
        tabindex="0"
        @scroll.debounce.90ms="sync()"
        @keydown.arrow-left.prevent="prev()"
        @keydown.arrow-right.prevent="next()"
      >
        {shots.map((shot, i) => (
          <figure class="w-[236px] shrink-0 sm:w-[262px] lg:w-[276px]">
            <div class="overflow-hidden rounded-[1.7rem] border border-primary-900/10 bg-white p-1.5 shadow-xl shadow-primary-900/10">
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[236, 262, 276, 552]}
                sizes="(min-width: 1024px) 276px, (min-width: 640px) 262px, 236px"
                format="webp"
                quality={80}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="h-auto w-full rounded-[1.35rem]"
              />
            </div>
          </figure>
        ))}
      </div>

      <div class="mt-7 flex items-center justify-center gap-4">
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-primary-900/10 bg-white text-primary-950 shadow-sm transition hover:border-primary-900/20 hover:bg-primary-50"
          :aria-label="$store.i18n.lang === 'zh' ? '上一张截图' : 'Previous screenshot'"
          @click="prev()"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div class="flex items-center gap-1.5">
          {shots.map((_, i) => (
            <button
              type="button"
              class="h-2 rounded-full transition-all duration-300"
              :class={`active === ${i} ? 'w-7 bg-primary-900' : 'w-2 bg-primary-900/25 hover:bg-primary-900/45'`}
              :aria-current={`active === ${i} ? 'true' : 'false'`}
              aria-label={`${i + 1} / ${shots.length}`}
              @click={`go(${i})`}
            ></button>
          ))}
        </div>

        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-primary-900/10 bg-white text-primary-950 shadow-sm transition hover:border-primary-900/20 hover:bg-primary-50"
          :aria-label="$store.i18n.lang === 'zh' ? '下一张截图' : 'Next screenshot'"
          @click="next()"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="reveal group relative overflow-hidden rounded-3xl border border-primary-900/8 bg-white p-6 transition-all duration-500 ease-out-expo hover:-translate-y-1 hover:border-brand-300/70 hover:shadow-[0_26px_52px_-26px_rgba(20,16,12,0.3)]">
          <span class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-brand-400/80 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
          <div class="mb-6 flex h-11 w-11 items-center justify-center rounded-2xl bg-primary-900/5 text-primary-700 transition-colors duration-500 group-hover:bg-brand-500/10 group-hover:text-brand-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </div>
          <h2 class="text-[17px] font-semibold tracking-tight text-primary-950" x-text="$store.i18n.t('index.feat1Title')">全天收音</h2>
          <p class="mt-2.5 text-sm leading-[1.75] text-primary-950/60" x-text="$store.i18n.t('index.feat1Desc')">前台服务 + 守护，锁屏也一直在听；本机人声检测只在有人说话时录，安静不录，实测约 0.5%/小时。</p>
        </article>
